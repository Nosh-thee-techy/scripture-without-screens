# Copy this file to .env and fill in real credentials. Never commit .env.

# --- YouVersion Platform (scripture text) ---
# Get an app key at https://developers.youversion.com
# Accept Bible licenses for each language you offer (en, sw, kln, ...).
YOUVERSION_API_KEY=your_youversion_platform_app_key
YOUVERSION_BASE_URL=https://api.youversion.com/v1
YOUVERSION_TIMEOUT_SECONDS=10

# --- Gloo AI Studio (personalized SMS reflections) ---
# Create credentials in Gloo AI Studio → API Credentials.
# Either set CLIENT_ID + CLIENT_SECRET (OAuth), or a ready bearer in GLOO_API_KEY.
# Skip if you have no card — use Featherless below instead.
GLOO_API_KEY=
GLOO_CLIENT_ID=your_gloo_client_id
GLOO_CLIENT_SECRET=your_gloo_client_secret
GLOO_BASE_URL=https://platform.ai.gloo.com/ai/v2/chat/completions
GLOO_TOKEN_URL=https://platform.ai.gloo.com/oauth2/token
GLOO_TIMEOUT_SECONDS=15

# --- Featherless (LLM for SMS reflections when Gloo needs a card) ---
FEATHERLESS_API_KEY=your_featherless_api_key
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# Prefer an ungated model; Meta-Llama often requires HuggingFace access.
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct
# Kids Corner cascade step 2 (after Qwen).
FEATHERLESS_GEMMA_MODEL=google/gemma-2-9b-it

# --- Local Ollama Gemma (Kids Corner cascade step 3) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_TIMEOUT_SECONDS=20

# --- Africa's Talking (USSD / SMS / Voice transport) ---
# Sandbox: https://account.africastalking.com — username is always "sandbox".
AT_API_KEY=your_africas_talking_api_key
AT_USERNAME=sandbox

# --- ElevenLabs (natural TTS for voice calls / mother-tongue audio) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

# Public HTTPS origin for Africa's Talking <Play> audio (your ngrok URL).
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.dev

# --- Redis (persistent language / version / plan day per phone) ---
# Local: redis://localhost:6379/0
# Docker: docker run -d -p 6379:6379 redis:7
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=2592000

# Optional secret for POST /jobs/daily-sms (cron / scheduler).
DAILY_SMS_JOB_SECRET=

# UTC hour (0-23) for the built-in daily SMS BackgroundScheduler.
# 05 ≈ 08:00 East Africa Time (UTC+3).
DAILY_SMS_HOUR_UTC=05

# Optional secret for GET /analytics/summary (header: X-Analytics-Secret).
ANALYTICS_SECRET=

# --- Meta WhatsApp Cloud API (test number OK for sandbox) ---
# Meta Developer → your app → WhatsApp → API setup / Getting started.
# Use the temporary test phone number first; paste IDs from that screen.
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
# Must match the Verify Token you type when creating the webhook in Meta.
WHATSAPP_VERIFY_TOKEN=sws-whatsapp-verify
WHATSAPP_API_VERSION=v22.0
# Optional: App Secret for X-Hub-Signature-256 checks on inbound webhooks.
WHATSAPP_APP_SECRET=
