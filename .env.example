# Copy this file to .env and replace placeholders with real credentials.
YOUVERSION_API_KEY=your_youversion_platform_app_key
YOUVERSION_BASE_URL=https://api.youversion.com/v1
YOUVERSION_TIMEOUT_SECONDS=10

# Use GLOO_API_KEY only if the hackathon supplies a ready-to-use bearer token.
GLOO_API_KEY=
# Standard Gloo AI Studio credentials use OAuth2 client credentials.
GLOO_CLIENT_ID=your_gloo_client_id
GLOO_CLIENT_SECRET=your_gloo_client_secret
GLOO_BASE_URL=https://platform.ai.gloo.com/ai/v2/chat/completions
GLOO_TOKEN_URL=https://platform.ai.gloo.com/oauth2/token
GLOO_TIMEOUT_SECONDS=15

AT_API_KEY=your_africas_talking_api_key
AT_USERNAME=sandbox
